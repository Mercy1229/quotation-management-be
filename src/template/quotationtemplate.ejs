<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sales Quotation</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=Montserrat:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
    @font-face {
  font-family: "Tamil MN";
  src: url("./fonts/TamilMN.woff2") format("woff2"),
       url("./fonts/TamilMN.woff") format("woff");
  font-weight: normal;
  font-style: normal;
}
  :root {
    --primary: #a10018;
    --primary-light: rgba(161, 0, 24, 0.12);
    --white: #ffffff;
    --text-light: rgba(255, 255, 255, 0.82);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 10px;
    background: #fff;
    font-family: "Inter", sans-serif;
  }
  .event-section {
  margin-top: 22px;
  border: 1.5px solid #e8e8e8;
  border-radius: 16px;
  padding: 20px;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 6px 24px rgba(0,0,0,0.05);
}

.event-badge {
  width: 120px;
  height: 80px;
  background-color: white;
  border: 4px solid #a10018;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20%;
  margin: 0 auto 16px;
}

.event-label {
  font-size: 14px;
  font-weight: 700;
  color: #17253a;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.event-number {
  font-size: 44px;
  font-weight: 700;
  color: #1f2328;
  margin-top: 4px;
}

.event-details-table,
.services-table,
.client-table,
.deliverables-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin-bottom: 16px;
  border-radius: 14px;
  overflow: hidden;
  border: 1.5px solid #e0e0e0;
  box-shadow: 0 4px 16px rgba(0,0,0,0.05);
}

.event-details-table td,
.services-table th,
.services-table td,
.client-table td,
.deliverables-table th,
.deliverables-table td {
  border-bottom: 1px solid #e8e8e8;
  border-right: 1px solid #e8e8e8;
  padding: 13px 18px;
  font-size: 14px;
  line-height: 1.5;
}

/* Remove right border on last column */
.event-details-table td:last-child,
.services-table th:last-child,
.services-table td:last-child,
.client-table td:last-child,
.deliverables-table th:last-child,
.deliverables-table td:last-child {
  border-right: none;
}

/* Remove bottom border on last row */
.event-details-table tr:last-child td,
.services-table tbody tr:last-child td,
.client-table tr:last-child td,
.deliverables-table tbody tr:last-child td {
  border-bottom: none;
}

/* Label / header cells */
.event-details-table .label,
.services-table th,
.client-table td:first-child,
.deliverables-table th {
  background: #a10018;
  color: white;
  font-weight: 700;
  width: 35%;
  letter-spacing: 0.3px;
}

/* Value cells */
.event-details-table .value,
.services-table td,
.client-table td:last-child,
.deliverables-table td {
  background: #fafafa;
  color: #444;
  font-weight: 500;
}

/* Alternating row shading for value rows */
.services-table tbody tr:nth-child(even) td,
.deliverables-table tbody tr:nth-child(even) td {
  background: #f4f4f4;
}

.services-table th,
.deliverables-table th {
  text-align: left;
}

.client-table td:first-child {
  width: 35%;
}

.services-table td:first-child,
.services-table td:last-child {
  width: 70px;
  text-align: center;
}
  /* Allow services grid to break across pages */
.services-list {
  break-inside: auto;
}

.service-list-item {
  break-inside: avoid;
  page-break-inside: avoid;
}

/* Let the services page grow naturally instead of being clipped */
.services-design-page {
  min-height: unset !important;
  height: auto !important;
  overflow: visible !important;
  page-break-inside: auto !important;
  break-inside: auto !important;
  page-break-after: always;
  break-after: page;
}

/* Each event block stays together but allows page breaks between events */
.event-section {
  break-inside: avoid;
  page-break-inside: avoid;
  overflow: visible;
}

  .cover {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background:
      /* linear-gradient(
        135deg,
        rgba(0, 0, 0, 0.72),
        rgba(161, 0, 24, 0.65)
      ), */
      url("<%= baseUrl %>/uploads/image1.1.jpeg")
      center/cover no-repeat;
    color: var(--white);
    padding: 50px 70px;
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    background:
  radial-gradient(
    ellipse 120% 60% at top center,
    rgba(161, 0, 24, 0.45) 0%,
    rgba(161, 0, 24, 0.25) 35%,
    transparent 80%
  );
 z-index: 1;
  }

  .cover-header {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-section {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .cover-brand-logo {
    width: 95px;
    height: 95px;
    object-fit: contain;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    padding: 12px;
    backdrop-filter: blur(6px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .brand-text {
    display: flex;
    font-family: "Tamil MN", serif;
    flex-direction: column;
  }

  .brand-subtitle {
    font-size: 12px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 6px;
  }

  .brand-text h2 {
    margin: 0;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--white);
  }

  .quotation-badge {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(2px);
    padding: 18px 26px;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
  }

  .quotation-small {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .quotation-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--white);
    margin-top: 4px;
  }

  .cover-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 89vh;
  }

  .cover-content-box {
    max-width: 760px;
    margin-top: 300px;
  }

  .proposal-by {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 8px;
  }

  .proposal-by strong {
    color: #fff;
    font-weight: 700;
  }

  .quote-revision {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 1px;
  }

  .divider {
    width: 120px;
    height: 5px;
    background: var(--primary);
    border-radius: 999px;
    margin: 30px 0;
    box-shadow: 0 0 20px rgba(161, 0, 24, 0.5);
  }

  .cover-content-box h1 {
    font-family: "Montserrat", sans-serif;
    font-size: 67px;
    line-height: 1;
    margin: 0;
    font-weight: 800;
    letter-spacing: -2px;
    color: var(--white);
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .cover-description {
    margin-top: 28px;
    font-size: 12px;
    line-height: 1.2;
    max-width: 680px;
    color: var(--text-light);
  }
.package-details-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  margin-top: 22px;
  margin-bottom: 0;
  padding: 20px;
  border: 1.5px solid #e8e8e8;
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 6px 24px rgba(0,0,0,0.05);
}

.package-box,
.validity-box {
  width: 100%;
  max-width: 700px;
  border: 1.5px solid #a10018;
  border-radius: 12px;
  padding: 20px;
  min-height: unset;
  box-shadow: 0 4px 14px rgba(161, 0, 24, 0.08);
  text-align: center;
}

.package-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 auto 10px;
  max-width: 460px;
  font-size: 13px;
  color: #666;
}

.total-row {
  margin-top: 10px;
  font-weight: 700;
}

.validity-box {
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.validity-title {
  font-size: 16px;
  color: #888;
  margin-bottom: 12px;
  font-weight: 600;
}

.validity-date {
  font-size: 18px;
  font-weight: 700;
  color: #444;
}
  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    html,
    body {
      width: 210mm;
      margin: 0;
      padding: 0;
      background: #fff !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .cover,
    .page,
    .final-thankyou-page {
      width: 100%;
      min-height: 297mm;
      margin: 0;
      padding: 12mm 10mm !important;
      page-break-after: always;
      break-after: page;
      page-break-inside: avoid;
      break-inside: avoid;
      overflow: hidden;
    }

    /* Services page must grow and allow page breaks */
    .services-design-page {
      min-height: unset !important;
      height: auto !important;
      overflow: visible !important;
      page-break-inside: auto !important;
      break-inside: auto !important;
    }

    .final-thankyou-page {
      page-break-after: avoid !important;
      break-after: avoid !important;
    }

    /* Ensure no trailing blank page after last element */
    body > *:last-child {
      page-break-after: avoid !important;
      break-after: avoid !important;
    }

    .page:last-child {
      page-break-after: avoid !important;
      break-after: avoid !important;
    }

    img {
