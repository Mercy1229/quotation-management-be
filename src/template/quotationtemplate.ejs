  :root{
    --primary:#a10018;
    --primary-light:rgba(161,0,24,0.08);
    --text:#1e1e1e;
    --muted:#666;
    --white:#fff;
  }

  /* =========================================
     PAGE COMMON
  ========================================= */

  .page{
    width:100%;
    min-height:100vh;
    padding:30px 60px 60px;
    background:#fff;
    position:relative;
    overflow:hidden;
    page-break-after:always;
    font-family:'Inter',sans-serif;
  }

  /* =========================================
     STORY PAGE
  ========================================= */

  .story-header{
    text-align:center;
    max-width:900px;
    margin:0 auto 50px;
  }

  .story-eyebrow{
    font-size:12px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:var(--primary);
    font-weight:700;
    margin-bottom:18px;
  }

  .story-header h2{
    font-size:30px;
    margin:0;
    font-family:'Inter',sans-serif;
    font-weight:800;
    color:#111;
  }

  .story-header p{
    margin-top:26px;
    font-size:17px;
    line-height:1.9;
    color:#555;
  }

  .story-hero{
    margin-top:24px;
    margin-bottom:0;
  }

  .story-hero-image{
    width:100%;
    min-height:460px;
    height:62vh;
    border-radius:34px;
    position:relative;
    overflow:hidden;
    background:
      linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.45)),
      url("<%= baseUrl %>/uploads/image2.1.jpeg")
      left/cover no-repeat;
  }

  .hero-image-overlay{
    position:absolute;
    inset:0;
    background:linear-gradient(
      135deg,
      rgba(161,0,24,0.35),
      transparent
    );
  }

  .hero-content{
    position:absolute;
    left:60px;
    bottom:60px;
    max-width:650px;
    color:#fff;
    background:transparent !important;
    border:none !important;
    box-shadow:none !important;
    padding:0;
    z-index:2;
  }

  .hero-content * {
    background:transparent !important;
  }

  .hero-mini-title{
    font-size:12px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:rgba(255,255,255,0.7);
  }

  .hero-content h3{
    font-size:54px;
    line-height:1.1;
    margin:18px 0;
    font-family:'Inter',sans-serif;
    font-weight:800;
  }

  .hero-content p{
    font-size:17px;
    line-height:1.9;
    color:rgba(255,255,255,0.88);
  }

  /* =========================================
     RITUALS GRID
  ========================================= */

  .rituals-grid{
    margin-top:70px;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:28px;
  }

  .ritual-card{
    padding:34px;
    border-radius:28px;
    background:#fff;
    border:1px solid #eee;
    box-shadow:0 12px 40px rgba(0,0,0,0.06);
  }

  .ritual-icon{
    width:62px;
    height:62px;
    border-radius:18px;
    background:var(--primary);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    margin-bottom:22px;
  }

  .ritual-card h4{
    font-size:28px;
    margin:0 0 14px;
    font-family:'Inter',sans-serif;
  }

  .ritual-card p{
    font-size:15px;
    line-height:1.8;
    color:#666;
  }

  .story-quote-box{
    margin-top:70px;
    padding:50px;
    border-radius:30px;
    background:var(--primary);
    color:#fff;
    position:relative;
  }

  .quote-line{
    width:80px;
    height:4px;
    background:#fff;
    border-radius:999px;
    margin-bottom:24px;
  }

  .story-quote-box p{
    font-size:28px;
    line-height:1.6;
    font-weight:500;
    margin:0;
  }

  .services-design-page{
    margin-top:20px;
    background: #7f0014;
  }

  .services-page-header{
    text-align:center;
    max-width:820px;
    margin:0 auto;
  }

  .services-mini{
    font-size:12px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:rgba(255,255,255,0.78);
    font-weight:700;
  }

  .services-page-header h2{
    font-size:60px;
    margin:20px 0;
    font-family:'Montserrat',sans-serif;
    font-weight:800;
    color:#fff;
  }

  .services-page-header p{
    font-size:17px;
    line-height:1.9;
    color:rgba(255,255,255,0.82);
  }

  .services-list{
    margin:0;
    padding:0;
    list-style:none;
      border:1.5px solid rgba(161, 0, 24, 0.28);
    border-radius:18px;
    overflow:hidden;
      background:linear-gradient(135deg, rgba(161, 0, 24, 0.1), rgba(161, 0, 24, 0.03));
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
  }

  .service-list-item{
    display:grid;
    grid-template-columns:72px 1fr;
    gap:0;
      border-bottom:1px solid rgba(161, 0, 24, 0.2);
      background:rgba(223, 220, 220, 0.5);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
  }

  .service-list-item:last-child{
    border-bottom:none;
  }

  .service-number{
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding-top:22px;
    background:var(--primary-light);
    color:var(--primary);
    font-weight:700;
    font-size:16px;
  }

  .service-content{
    padding:18px 22px;
    /* background:#7f0014; */
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .service-content h3{
    margin:4px 0 6px;
    font-size:24px;
    font-family:'Inter',sans-serif;
    color:var(--white);
    font-weight:700;
    white-space:nowrap;
  }

  /* If the number block is removed, let content use the full row width */
  .service-list-item > .service-content:only-child{
