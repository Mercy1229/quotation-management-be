<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sales Quotation – Sunitha & Arjun</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=Montserrat:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
  :root {
    --primary: #a10018;
    /* --primary-light: rgba(161, 0, 24, 0.12); */
    --white: #ffffff;
    --text-light: rgba(255, 255, 255, 0.82);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    /* background: #111; */
    /* font-family: "Poppins", sans-serif; */
  }
  .event-section {
  margin-top: 28px;
}

.event-badge {
  width: 110px;
  height: 110px;
  background-color: white;
  border: 4px solid #a10018;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;

  /* Add this */
  border-radius: 20%;
}

.event-label {
  font-size: 18px;
  font-weight: 700;
  color: #17253a;
  letter-spacing: 1px;
}

.event-number {
  font-size: 44px;
  font-weight: 700;
  color: #1f2328;
  margin-top: 6px;
}

.event-details-table,
.services-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
}

.event-details-table td,
.services-table th,
.services-table td {
  border: 1px solid #3d3d3d;
  padding: 12px 10px;
  font-size: 15px;
}

.event-details-table .label,
.services-table th {
  background: #a10018;
  color: white;
  font-weight: 700;
}

.event-details-table .value,
.services-table td {
  background: #f4f4f4;
  color: #7d8288;
  font-weight: 600;
}

.services-table th {
  text-align: left;
}

.services-table td:first-child,
.services-table td:last-child {
  width: 120px;
}
  /* Allow services grid to break across pages */
.services-grid {
  break-inside: auto;
}

.service-card {
  break-inside: avoid;
  page-break-inside: avoid;
}

/* Let the services page grow naturally instead of being clipped */
.services-design-page {
  min-height: unset;
  height: auto;
  page-break-after: always;
}

  .cover {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background:
      linear-gradient(
        135deg,
        rgba(0, 0, 0, 0.72),
        rgba(161, 0, 24, 0.65)
      ),
      url("https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=1600&auto=format&fit=crop")
      center/cover no-repeat;
    color: var(--white);
    padding: 50px 70px;
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top right, rgba(161, 0, 24, 0.45), transparent 40%),
      radial-gradient(circle at bottom left, rgba(161, 0, 24, 0.25), transparent 35%);
    z-index: 1;
  }

  .cover-header {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-section {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .cover-brand-logo {
    width: 95px;
    height: 95px;
    object-fit: contain;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    padding: 12px;
    backdrop-filter: blur(6px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-subtitle {
    font-size: 12px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 6px;
  }

  .brand-text h2 {
    margin: 0;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--white);
  }

  .quotation-badge {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    padding: 18px 26px;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
  }

  .quotation-small {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .quotation-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--white);
    margin-top: 4px;
  }

  .cover-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 78vh;
  }

  .cover-content-box {
    max-width: 760px;
  }

  .proposal-by {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 8px;
  }

  .proposal-by strong {
    color: #fff;
    font-weight: 700;
  }

  .quote-revision {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 1px;
  }

  .divider {
    width: 120px;
    height: 5px;
    background: var(--primary);
    border-radius: 999px;
    margin: 30px 0;
    box-shadow: 0 0 20px rgba(161, 0, 24, 0.5);
  }

  .cover-content-box h1 {
    font-family: "Montserrat", sans-serif;
    font-size: 82px;
    line-height: 1.05;
    margin: 0;
    font-weight: 800;
    letter-spacing: -2px;
    color: var(--white);
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .cover-description {
    margin-top: 28px;
    font-size: 19px;
    line-height: 1.9;
    max-width: 680px;
    color: var(--text-light);
  }

  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    html,
    body {
      width: 210mm;
      margin: 0;
      padding: 0;
      background: #fff !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .cover,
    .page,
    .final-thankyou-page {
      width: 100%;
      min-height: 297mm;
      margin: 0;
      page-break-after: always;
      break-after: page;
      page-break-inside: avoid;
      break-inside: avoid;
      overflow: hidden;
    }

    .final-thankyou-page {
      page-break-after: auto;
      break-after: auto;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .service-card,
    .client-details-card,
    .story-hero-image,
    .quotation-badge,
    .final-logo-circle,
    .client-table,
    .client-table tr,
    .client-table td {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .client-table {
      width: 100%;
      table-layout: fixed;
    }
  }

  :root{
    --primary:#a10018;
    --primary-light:rgba(161,0,24,0.08);
    --text:#1e1e1e;
    --muted:#666;
    --white:#fff;
  }

  /* =========================================
     PAGE COMMON
  ========================================= */

  .page{
    width:100%;
    min-height:100vh;
    padding:60px;
    background:#fff;
    position:relative;
    overflow:hidden;
    page-break-after:always;
    font-family:'Poppins',sans-serif;
  }

  /* =========================================
     STORY PAGE
  ========================================= */

  .story-header{
    text-align:center;
    max-width:900px;
    margin:0 auto 50px;
  }

  .story-eyebrow{
    font-size:12px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:var(--primary);
    font-weight:700;
    margin-bottom:18px;
  }

  .story-header h2{
    font-size:54px;
    line-height:1.15;
    margin:0;
    font-family:'Montserrat',sans-serif;
    font-weight:800;
    color:#111;
  }

  .story-header p{
    margin-top:26px;
    font-size:17px;
    line-height:1.9;
    color:#555;
  }

  .story-hero{
    margin-top:50px;
  }

  .story-hero-image{
    height:480px;
    border-radius:34px;
    position:relative;
    overflow:hidden;
    background:
      linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.45)),
      url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1600&auto=format&fit=crop')
      center/cover no-repeat;
  }

  .hero-image-overlay{
    position:absolute;
    inset:0;
    background:linear-gradient(
      135deg,
      rgba(161,0,24,0.35),
      transparent
    );
  }

  .hero-content{
    position:absolute;
    left:60px;
    bottom:60px;
    max-width:650px;
    color:#fff;
  }

  .hero-mini-title{
    font-size:12px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:rgba(255,255,255,0.7);
  }

  .hero-content h3{
    font-size:54px;
    line-height:1.1;
    margin:18px 0;
    font-family:'Montserrat',sans-serif;
    font-weight:800;
  }

  .hero-content p{
    font-size:17px;
    line-height:1.9;
    color:rgba(255,255,255,0.88);
  }

  /* =========================================
     RITUALS GRID
  ========================================= */

  .rituals-grid{
    margin-top:70px;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:28px;
  }

  .ritual-card{
    padding:34px;
    border-radius:28px;
    background:#fff;
    border:1px solid #eee;
    box-shadow:0 12px 40px rgba(0,0,0,0.06);
  }

  .ritual-icon{
    width:62px;
    height:62px;
    border-radius:18px;
    background:var(--primary);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    margin-bottom:22px;
  }

  .ritual-card h4{
    font-size:28px;
    margin:0 0 14px;
    font-family:'Montserrat',sans-serif;
  }

  .ritual-card p{
    font-size:15px;
    line-height:1.8;
    color:#666;
  }

  .story-quote-box{
    margin-top:70px;
    padding:50px;
    border-radius:30px;
    background:var(--primary);
    color:#fff;
    position:relative;
  }

  .quote-line{
    width:80px;
    height:4px;
    background:#fff;
    border-radius:999px;
    margin-bottom:24px;
  }

  .story-quote-box p{
    font-size:28px;
    line-height:1.6;
    font-weight:500;
    margin:0;
  }

  /* =========================================
     SERVICES PAGE
  ========================================= */

  .services-design-page{
    background:
      linear-gradient(
        to bottom right,
        #fff,
        rgba(161,0,24,0.03)
      );
  }

  .services-page-header{
    text-align:center;
    max-width:820px;
    margin:0 auto 70px;
  }

  .services-mini{
    font-size:12px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:var(--primary);
    font-weight:700;
  }

  .services-page-header h2{
    font-size:60px;
    margin:20px 0;
    font-family:'Montserrat',sans-serif;
    font-weight:800;
  }

  .services-page-header p{
    font-size:17px;
    line-height:1.9;
    color:#666;
  }

  .services-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:28px;
  }

  .service-card{
    background:#fff;
    border-radius:30px;
    padding:36px;
    border:1px solid #eee;
    box-shadow:0 12px 35px rgba(0,0,0,0.05);
    transition:0.3s;
  }

  .service-number{
    width:62px;
    height:62px;
    border-radius:18px;
    background:var(--primary-light);
    color:var(--primary);
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:700;
    margin-bottom:24px;
  }

  .service-card h3{
    margin:0 0 14px;
    font-size:28px;
    font-family:'Montserrat',sans-serif;
  }

  .service-card p{
    color:#666;
    line-height:1.8;
    font-size:15px;
  }

  .services-highlight-box{
    margin-top:70px;
    background:var(--primary);
    border-radius:34px;
    padding:50px;
    color:#fff;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }

  .highlight-left{
    max-width:600px;
  }

  .highlight-left h3{
    font-size:42px;
    margin:0 0 20px;
    font-family:'Montserrat',sans-serif;
  }

  .highlight-left p{
    line-height:1.9;
    color:rgba(255,255,255,0.85);
  }

  .highlight-right{
    display:flex;
    gap:30px;
  }

  .highlight-stat{
    text-align:center;
    min-width:140px;
  }

  .highlight-stat span{
    display:block;
    font-size:52px;
    font-weight:800;
    margin-bottom:10px;
  }

  /* =========================================
     CLIENT SECTION
  ========================================= */

  .client-section{
    margin-top:70px;
    padding:40px 0;
  }

  /* =========================================
     HEADER
  ========================================= */

  .client-header{
    text-align:center;
    margin-bottom:40px;
  }

  .client-mini-title{
    font-size:12px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:var(--primary);
    font-weight:700;
  }

  .client-header h2{
    margin:18px 0 12px;
    font-size:48px;
    font-family:'Montserrat',sans-serif;
    font-weight:800;
    color:#111;
  }

  .client-header p{
    max-width:700px;
    margin:0 auto;
    color:#666;
    line-height:1.8;
    font-size:16px;
  }

  /* =========================================
     CARD
  ========================================= */

  .client-details-card{
    background:#fff;
    border-radius:30px;
    padding:35px;
    border:1px solid rgba(0,0,0,0.06);

    box-shadow:
      0 18px 50px rgba(0,0,0,0.06);
  }

  /* =========================================
     TABLE
  ========================================= */

  .client-table{
    width:100%;
    border-collapse:collapse;
    overflow:hidden;
    border-radius:20px;
  }

  .client-table tr{
    transition:0.3s;
  }

  .client-table tr:nth-child(odd){
    background:rgba(161,0,24,0.03);
  }

  .client-table tr:hover{
    background:rgba(161,0,24,0.06);
  }

  .client-table td{
    padding:22px 26px;
    border:1px solid rgba(0,0,0,0.08);
  }

  .client-table td:first-child{
    width:35%;
    font-size:15px;
    font-weight:700;
    letter-spacing:0.5px;
    color:#777;
    background:rgba(161,0,24,0.04);
  }

  .client-table td:last-child{
    font-size:17px;
    font-weight:600;
    color:#222;
  }

  /* =========================================
     MOBILE SAFE
  ========================================= */

  @media(max-width:768px){

    .client-header h2{
      font-size:34px;
    }

    .client-table td{
      padding:16px;
      font-size:14px;
    }

  }

  .logo-stack{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:6px;
    margin-bottom:10px;
  }

  .final-logo-circle{
    width:170px;
    height:170px;
    border-radius:50%;
    background:
      linear-gradient(
        135deg,
        #a10018,
        #760012
      );

    display:flex;
    align-items:center;
    justify-content:center;

    border:6px solid rgba(255,255,255,0.85);

    box-shadow:
      0 20px 60px rgba(161,0,24,0.22);

    overflow:hidden;
  }

  .final-logo{
    width:100px;
    height:100px;
    object-fit:contain;
  }

  .text-logo{
    width:250px;
    height:110px;
    object-fit:contain;
    display:block;
    margin:0;
    padding:0;
  }
  .final-thankyou-page{
    position:relative;
    overflow:hidden;
    background:
      linear-gradient(
        135deg,
        #ffffff,
        rgba(161,0,24,0.03)
      );
    min-height:100vh;
    padding:70px 70px 50px;
    font-family:'Poppins',sans-serif;
  }

  /* =========================================
     BACKGROUND DESIGN
  ========================================= */

  .thankyou-bg-circle{
    position:absolute;
    border-radius:50%;
    background:rgba(161,0,24,0.05);
    z-index:0;
  }

  .thankyou-bg-circle.one{
    width:500px;
    height:500px;
    top:-180px;
    right:-120px;
  }

  .thankyou-bg-circle.two{
    width:320px;
    height:320px;
    bottom:-100px;
    left:-100px;
  }

  /* =========================================
     TOP TEXT
  ========================================= */

  .final-top-text{
    position:relative;
    z-index:2;
    text-align:center;
    font-size:12px;
    letter-spacing:5px;
    text-transform:uppercase;
    color:var(--primary);
    font-weight:700;
  }

  /* =========================================
     LOGO
  ========================================= */

  .final-logo-wrapper{
    position:relative;
    z-index:2;
    display:flex;
    justify-content:center;
    margin-top:35px;
    margin-bottom:25px;
  }

  .final-logo-circle{
    width:190px;
    height:190px;
    border-radius:50%;
    background:
      linear-gradient(
        135deg,
        #a10018,
        #760012
      );
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    border:8px solid rgba(255,255,255,0.8);

    box-shadow:
      0 25px 70px rgba(161,0,24,0.25),
      inset 0 0 35px rgba(255,255,255,0.08);

    overflow:hidden;
  }

  .final-logo{
    width:120px;
    height:120px;
    object-fit:contain;
    filter:drop-shadow(0 8px 18px rgba(0,0,0,0.25));
  }

  .logo-glow{
    position:absolute;
    width:260px;
    height:260px;
    border-radius:50%;
    background:rgba(161,0,24,0.12);
    filter:blur(25px);
    z-index:-1;
  }

  /* =========================================
     MAIN CONTENT
  ========================================= */

  .final-center-content{
    position:relative;
    z-index:2;
    text-align:center;
    max-width:920px;
    margin:0 auto;
  }

  .thankyou-mini{
    font-size:14px;
    letter-spacing:5px;
    text-transform:uppercase;
    color:#666;
    margin-bottom:22px;
  }

  .final-center-content h1{
    margin:0;
    font-size:92px;
    line-height:1;
    font-family:'Montserrat',sans-serif;
    font-weight:800;
    letter-spacing:-3px;
    color:#111;
  }

  .thankyou-description{
    margin:38px auto 0;
    max-width:760px;
    font-size:19px;
    line-height:2;
    color:#555;
  }

  .thankyou-divider{
    width:120px;
    height:5px;
    background:var(--primary);
    border-radius:999px;
    margin:45px auto;
  }

  /* =========================================
     SIGNATURE BOX
  ========================================= */

  .signature-box{
    margin-top:25px;
    background:#fff;
    border-radius:32px;
    padding:48px;
    border:1px solid rgba(0,0,0,0.06);

    box-shadow:
      0 20px 60px rgba(0,0,0,0.06);
  }

  .signature-line{
    width:80px;
    height:4px;
    background:var(--primary);
    border-radius:999px;
    margin:0 auto 24px;
  }

  .signature-content h3{
    margin:0;
    font-size:36px;
    font-family:'Montserrat',sans-serif;
    color:#111;
  }

  .signature-content p{
    margin-top:18px;
    font-size:16px;
    line-height:1.9;
    color:#666;
  }

  /* =========================================
     PARTNERS
  ========================================= */

  .partners-section{
    position:relative;
    z-index:2;
    margin-top:70px;
  }

  .partners-heading{
    text-align:center;
    font-size:14px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:var(--primary);
    font-weight:700;
    margin-bottom:35px;
  }

  .partners-grid{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:22px;
  }

  .partner-card{
    background:#fff;
    border-radius:26px;
    padding:30px 18px;
    text-align:center;
    border:1px solid rgba(0,0,0,0.06);

    box-shadow:
      0 14px 40px rgba(0,0,0,0.05);
  }

  .partner-icon{
    width:72px;
    height:72px;
    margin:0 auto 18px;
    border-radius:20px;
    background:var(--primary);

    display:flex;
    align-items:center;
    justify-content:center;

    color:#fff;
    font-size:24px;
    font-weight:700;
    font-family:'Montserrat',sans-serif;
  }

  .partner-name{
    font-size:15px;
    line-height:1.6;
    color:#333;
    font-weight:500;
  }

  /* =========================================
     FOOTER
  ========================================= */

  .final-footer{
    position:relative;
    z-index:2;
    margin-top:70px;
  }

  .footer-locations{
    text-align:center;
    font-size:15px;
    color:#666;
    letter-spacing:1px;
  }

  .footer-divider{
    width:100%;
    height:1px;
    background:rgba(0,0,0,0.08);
    margin:28px 0;
  }

  .footer-bottom{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;

    font-size:14px;
    color:#777;
  }

  .footer-center{
    color:var(--primary);
    font-weight:600;
  }
   
  </style>
</head>
<body>
<div class="cover">
  <div class="cover-overlay"></div>

  <!-- Header -->
  <div class="cover-header">
    <div class="brand-section">
      <img
        class="cover-brand-logo"
        src="<%= baseUrl %>/uploads/White.png"
        alt="Studio Logo"
      />

      <div class="brand-text">
        <h2>YOURS BIGDAY STUDIOS</h2>
      </div>
    </div>

    <div class="quotation-badge">
      <span class="quotation-title">Sales Quotation</span>
    </div>
  </div>

  <!-- Hero Content -->
  <div class="cover-content">
    <div class="cover-content-box">
     

   

      <div class="divider"></div>

      <h1>
        Your Beautiful <br />
        Forever Begins Here
      </h1>

      <p class="cover-description">
        Capturing timeless emotions, heartfelt moments, elegant celebrations,
        and unforgettable memories with artistic storytelling and cinematic
        perfection tailored exclusively for your special day.
      </p>
    </div>
  </div>
</div>
  <!-- ═══════════════════════════════════
       INTRO SECTION
  ════════════════════════════════════ -->
 <!-- ═══════════════════════════════════
     PAGE 2 — WEDDING STORY / EXPERIENCE
════════════════════════════════════ -->
<div class="page wedding-story-page">

  <div class="story-header">
    <div class="story-eyebrow">Traditional Wedding Experience</div>
    <h2>
      A Celebration Rooted In <br>
      Culture, Rituals & Timeless Love
    </h2>

    <p>
      A traditional wedding is not just a ceremony — it is an emotional
      journey filled with sacred rituals, vibrant celebrations, blessings,
      family traditions, and unforgettable moments that deserve to be captured
      beautifully for generations to cherish.
    </p>
  </div>

  <!-- HERO SECTION -->
  <div class="story-hero">

    <div class="story-hero-image">
      <div class="hero-image-overlay"></div>

      <div class="hero-content">
        <span class="hero-mini-title">Sacred Moments</span>

        <h3>
          From The First Blessing <br>
          To The Final Ritual
        </h3>

        <p>
          Every smile, every ritual, every emotional glance and every sacred
          promise becomes a timeless memory through our cinematic storytelling
          and artistic wedding photography experience.
        </p>
      </div>
    </div>

  </div>
  <!-- QUOTE BLOCK -->

</div>


<!-- ═══════════════════════════════════
     PAGE 3 — SERVICES PAGE
════════════════════════════════════ -->
<div class="page services-design-page">

  <div class="services-page-header">
    <span class="services-mini">Premium Wedding Coverage</span>

    <h2>Our Signature Services</h2>

    <p>
      Curated cinematic photography and wedding filmmaking services designed to
      transform your once-in-a-lifetime moments into timeless visual memories.
    </p>
  </div>

  <!-- SERVICES GRID -->
  <div class="services-grid">

    <div class="service-card">
      <div class="service-number">01</div>
      <h3>Candid Photography</h3>
      <p>
        Emotion-driven storytelling through natural and timeless candid wedding
        frames.
      </p>
    </div>

    <div class="service-card">
      <div class="service-number">02</div>
      <h3>Cinematic Videography</h3>
      <p>
        Premium wedding films crafted with cinematic visuals, music and
        emotional storytelling.
      </p>
    </div>

    <div class="service-card">
      <div class="service-number">03</div>
      <h3>Traditional Coverage</h3>
      <p>
        Complete traditional photography and videography coverage for rituals
        and ceremonies.
      </p>
    </div>

    <div class="service-card">
      <div class="service-number">04</div>
      <h3>Drone / Helicam</h3>
      <p>
        Stunning aerial wedding visuals and cinematic venue coverage with
        premium drone shots.
      </p>
    </div>

    <div class="service-card">
      <div class="service-number">05</div>
      <h3>Live Streaming</h3>
      <p>
        Seamless high-quality wedding live streaming experience for friends and
        family worldwide.
      </p>
    </div>

    <div class="service-card">
      <div class="service-number">06</div>
      <h3>Wedding Film</h3>
      <p>
        Emotional cinematic wedding edits crafted with storytelling, music and
        artistic visuals.
      </p>
    </div>
<!-- ADD THESE INSIDE .services-grid -->

<div class="service-card">
  <div class="service-number">07</div>
  <h3>Pre-Wedding Shoot</h3>
  <p>
    Romantic cinematic pre-wedding storytelling with creative concepts,
    beautiful locations and elegant couple portraits.
  </p>
</div>

<div class="service-card">
  <div class="service-number">08</div>
  <h3>Post-Wedding Shoot</h3>
  <p>
    Timeless post-wedding photography sessions crafted with cinematic visuals,
    emotional storytelling and artistic direction.
  </p>
</div>

<div class="service-card">
  <div class="service-number">09</div>
  <h3>Indoor Studio Shoot</h3>
  <p>
    Premium indoor photography sessions with professional lighting, elegant
    backdrops and creative portrait styling.
  </p>
</div>

<div class="service-card">
  <div class="service-number">10</div>
  <h3>Outdoor Shoot</h3>
  <p>
    Natural outdoor photography experiences capturing candid emotions,
    beautiful landscapes and authentic moments.
  </p>
</div>

<div class="service-card">
  <div class="service-number">11</div>
  <h3>Toddler Photography</h3>
  <p>
    Adorable toddler photography sessions filled with playful moments, joyful
    expressions and heartwarming memories.
  </p>
</div>

<div class="service-card">
  <div class="service-number">12</div>
  <h3>Maternity Shoot</h3>
  <p>
    Elegant maternity portraits celebrating motherhood with artistic styling,
    emotional storytelling and timeless elegance.
  </p>
</div>
  </div>

</div>
<!-- ═══════════════════════════════════
     CLIENT DETAILS SECTION
════════════════════════════════════ -->
<div class="page client-section">

  <div class="client-header">
    <span class="client-mini-title">Wedding Details</span>

    <h2>
      Client Information
    </h2>

    <p>
      Personalized quotation details prepared exclusively for your wedding
      celebration and memorable events.
    </p>
  </div>

  <div class="client-details-card">

    <table class="client-table">
      <tbody>
 <tr>
          <td>Client Name</td>
          <td>
            <%= data.customerName || "-" %>
          </td>
        </tr>
    
        <tr>
          <td>Bride & Groom Name</td>
          <td>
            <%= data.brideName || "-" %> & <%= data.groomName || "-" %>
          </td>
        </tr>

       

        <tr>
          <td>Event Type</td>
          <td>
            <%= data.eventType || "-" %>
          </td>
        </tr>
        <tr>
          <td>Event Date</td>
          <td>
            <%= data.eventDate || "-" %>
          </td>
        </tr>

        <tr>
          <td>Event Location</td>
          <td>
            <%= data.location || "-" %>
          </td>
        </tr>

      </tbody>
    </table>

  </div>

</div>
<% if (data.events && data.events.length) { %>
  <% data.events.forEach((event, index) => { %>

    <div class="event-section">

      <!-- Event Number Box -->
      <div class="event-badge">
        <span class="event-label">EVENT</span>
        <span class="event-number"><%= index + 1 %></span>
      </div>

      <!-- Event Details Table -->
      <table class="event-details-table">
        <tbody>

          <tr>
            <td class="label">Event Name</td>
            <td class="value"><%= event.eventName || "-" %></td>

            <td class="label">Date</td>
            <td class="value"><%= event.date || "-" %></td>
          </tr>

          <tr>
            <td class="label">Venue Name</td>
            <td class="value"><%= event.venueName || "-" %></td>

            <td class="label">Crowd Strength</td>
            <td class="value"><%= event.crowdStrength || "-" %></td>
          </tr>

          <tr>
            <td class="label">Venue Location</td>
            <td class="value"><%= event.venueLocation || "-" %></td>

            <td class="label">Start Time</td>
            <td class="value"><%= event.startTime || "-" %></td>
          </tr>

          <tr>
            <td class="label">Services</td>
            <td class="value" colspan="3">
              <%= event.endTime || "-" %>
            </td>
          </tr>

        </tbody>
      </table>

      <!-- Services Table -->
      <table class="services-table">
        <thead>
          <tr>
            <th>S.No</th>
            <th>Services</th>
            <th>Cameras</th>
          </tr>
        </thead>

        <tbody>
          <% if (event.services && event.services.length) { %>
            <% event.services.forEach((service, sIndex) => { %>
              <tr>
                <td><%= sIndex + 1 %></td>
                <td><%= service.service || "-" %></td>
                <td><%= service.cameras || "-" %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>

    </div>

  <% }) %>
<% } %>
  <!-- ═══════════════════════════════════
       THANK YOU / FOOTER
  ════════════════════════════════════ -->
<div class="page final-thankyou-page">

  <!-- BACKGROUND DESIGN -->
  <div class="thankyou-bg-circle one"></div>
  <div class="thankyou-bg-circle two"></div>

  <!-- TOP SMALL TEXT -->
  <div class="final-top-text">
    Premium Wedding Photography & Cinematic Experience
  </div>

  <!-- LOGO -->
  <div class="final-logo-wrapper">

    <div class="logo-glow"></div>

 <div class="logo-stack">

  <!-- ROUND LOGO -->
  <div class="final-logo-circle">
    <img
      src="<%= baseUrl %>/uploads/white.png"
      alt="Yours Bigday Studios"
      class="final-logo"
    />
  </div>

  <!-- TEXT LOGO -->
  <img
    src="<%= baseUrl %>/uploads/logo-text.png"
    alt="Yours Bigday Studios"
    class="text-logo"
  />

</div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="final-center-content">
 <div class="thankyou-mini">
      THANK YOU FOR CHOOSING
    </div>
    <p class="thankyou-description">
      Thank you for considering us to be a part of your beautiful journey.
      We are honoured to capture your emotions, traditions, celebrations and
      timeless memories with elegance, creativity and cinematic storytelling.
    </p>

    

    <div class="signature-box">

      <div class="signature-content">
        <h3>Crafting Memories That Last Forever</h3>

        <p>
          Every WEDDING has a unique story and we believe every emotion deserves
          to be preserved beautifully for generations to cherish forever.
        </p>
         <div class="signature-line"></div>

      </div>

    </div>

  </div>


  <!-- FOOTER -->
  <div class="final-footer">

    <div class="footer-locations">
      Thoothukudi • Coimbatore • Tirunelveli
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">

      <div class="footer-left">
        © Yours Bigday Studios
      </div>

      <div class="footer-center">
        www.yoursbigdaystudios.com
      </div>

      <div class="footer-right">
        Terms & Conditions Apply
      </div>

    </div>

  </div>

</div>
</body>
</html>