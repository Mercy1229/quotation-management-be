          <td>Bride & Groom Name</td>
          <td>
            <%= data.brideName || "-" %> & <%= data.groomName || "-" %>
          </td>
        </tr>

       

        <tr>
          <td>Event Type</td>
          <td>
            <%= data.eventType || "-" %>
          </td>
        </tr>
        <tr>
          <td>Event Date</td>
          <td>
            <%= (() => { const raw = data.eventDate; if (!raw) return "-"; const parsed = new Date(raw); if (Number.isNaN(parsed.getTime())) return raw; return parsed.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }); })() %>
          </td>
        </tr>

        <tr>
          <td>Event Location</td>
          <td>
            <%= data.location || "-" %>
          </td>
        </tr>

      </tbody>
    </table>

  </div>
<% if (data.events && data.events.length) { %>
  <% data.events.forEach((event, index) => { %>

    <div class="event-section">

      <!-- Event Number Box -->
      <div class="event-badge">
        <span class="event-label">EVENT - <%= index + 1 %></span>
        <!-- <span class="event-number"><%= index + 1 %></span> -->
      </div>

      <!-- Event Details Table -->
      <table class="event-details-table">
        <colgroup>
          <col style="width:25%">
          <col style="width:25%">
          <col style="width:25%">
          <col style="width:25%">
        </colgroup>
        <tbody>

          <tr>
            <td class="label">Event Name</td>
            <td class="value" colspan="3"><%= event.eventName || "-" %></td>
          </tr>
          <tr>
            <td class="label">Date</td>
            <td class="value" colspan="3"><%= (() => { const raw = event.date; if (!raw) return "-"; const parsed = new Date(raw); if (Number.isNaN(parsed.getTime())) return raw; return parsed.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }); })() %></td>
          </tr>
          <!-- <tr>
            <td class="label">Venue Name</td>
            <td class="value" colspan="3"><%= event.venueName || "-" %></td>
          </tr> -->
          <tr>
            <td class="label">Venue</td>
            <td class="value" colspan="3"><%= event.venueLocation || "-" %></td>
          </tr>
          <tr>
            <td class="label">Crowd Strength</td>
            <td class="value" colspan="3"><%= event.crowdStrength || "-" %></td>
          </tr>
          <tr>
            <td class="label">Start Time</td>
            <td class="value"><%= event.startTime || "-" %></td>
            <td class="label">End Time</td>
            <td class="value"><%= event.endTime || "-" %></td>
          </tr>

        </tbody>
      </table>

      <!-- Services Table -->
      <table class="services-table">
        <thead>
          <tr>
            <th>S.No</th>
            <th>Services</th>
            <th>Cameras</th>
          </tr>
        </thead>

        <tbody>
          <% if (event.services && event.services.length) { %>
            <% event.services.forEach((service, sIndex) => { %>
              <tr>
                <td><%= sIndex + 1 %></td>
                <td><%= service.service || "-" %></td>
                <td><%= service.cameras || "-" %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>

    </div>

  <% }) %>
<% } %>
<% if (data.photoDeliverables && data.photoDeliverables.length > 0) { %>
<div class="">
  <div class="deliverables-section">
    <h2 class="deliverables-title">PHOTO DELIVERABLES</h2>
    <table class="deliverables-table">
      <thead>
        <tr>
          <th>Photo Deliverables</th>
          <th>Event Name</th>
          <th>Qty</th>
        </tr>
      </thead>
      <tbody>
        <% data.photoDeliverables.forEach((item) => { %>
          <tr>
            <td><%= item.name || "-" %></td>
            <td><%= item.eventName || "-" %></td>
            <td><%= item.qty || "-" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% if (data.videoDeliverables && data.videoDeliverables.length > 0) { %>
<div class="">
  <div class="deliverables-section">
    <h2 class="deliverables-title">VIDEO DELIVERABLES</h2>
    <table class="deliverables-table">
      <thead>
        <tr>
          <th>Video Deliverables</th>
          <th>Event Name</th>
          <th>Qty</th>
        </tr>
      </thead>
      <tbody>
        <% data.videoDeliverables.forEach((item) => { %>
          <tr>
            <td><%= item.name || "-" %></td>
            <td><%= item.eventName || "-" %></td>
            <td><%= item.qty || "-" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

